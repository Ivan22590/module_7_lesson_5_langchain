# ============================================================
# Шаблон переменных окружения. Скопируйте в .env и заполните
# ТОЛЬКО обязательные ключи. Остальные параметры имеют рабочие
# значения по умолчанию и менять их не нужно.
# ============================================================

# --- ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ -------------------------------------

# 1. Ключ ProxyAPI (нейросеть) — личный кабинет https://proxyapi.ru
PROXYAPI_API_KEY=

# 2. Токен Telegram-бота — получить у @BotFather
BOT_TOKEN=

# --- НЕОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ (значения по умолчанию) -------

# ProxyAPI (модель по умолчанию: openai/gpt-6-luna)
#PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
#PROXYAPI_MODEL=openai/gpt-6-luna
#PROXYAPI_TIMEOUT=90
#PROXYAPI_MAX_RETRIES=2

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO
